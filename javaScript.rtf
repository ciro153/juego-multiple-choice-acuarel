\f0\fs24 \cf0 // --- \uc0\u55356 \u57256  CONFIGURACI\'d3N CENTRAL: LISTA DE PREGUNTAS ---\
// Puedes a\'f1adir m\'e1s preguntas a esta lista (Array)\
const QUIZ_DATA = [\
    \{\
        question: "\'bfQu\'e9 aglutinante principal se utiliza tradicionalmente para dar cohesi\'f3n a los pigmentos de la acuarela?",\
        correct_answer: "Goma ar\'e1biga",\
        options: ["Aceite de linaza", "Cera de abeja", "Goma ar\'e1biga", "Case\'edna"]\
    \},\
    \{\
        question: "\'bfCu\'e1l es la funci\'f3n principal de la 'tempera' (gouache) en comparaci\'f3n con la acuarela simple?",\
        correct_answer: "Ser opaca y cubriente",\
        options: ["Secar m\'e1s r\'e1pido", "Ser totalmente transparente", "Ser opaca y cubriente", "Necesitar aguarr\'e1s"]\
    \},\
    \{\
        question: "\'bfQu\'e9 herramienta es esencial para crear reservas de blanco en la acuarela?",\
        correct_answer: "L\'edquido de enmascarar",\
        options: ["Borrador de grafito", "Goma maleable", "L\'edquido de enmascarar", "Cinta adhesiva"]\
    \},\
    \{\
        question: "\'bfQu\'e9 color se obtiene al mezclar azul y amarillo?",\
        correct_answer: "Verde",\
        options: ["P\'farpura", "Naranja", "Verde", "Marr\'f3n"]\
    \},\
    \{\
        question: "\'bfQu\'e9 tipo de pincel es ideal para la t\'e9cnica de 'lavado' (grandes \'e1reas de color) en acuarela?",\
        correct_answer: "Pincel plano grande",\
        options: ["Pincel de abanico", "Pincel plano grande", "Pincel fino de detalle", "Esponja vegetal"]\
    \},\
    \{\
        question: "\'bfCu\'e1l es el pigmento blanco m\'e1s com\'fan y utilizado en casi todas las pinturas, incluyendo t\'e9mperas?",\
        correct_answer: "Di\'f3xido de titanio",\
        options: ["Di\'f3xido de titanio", "\'d3xido de hierro", "Negro de humo", "Sulfato de bario"]\
    \}\
];\
// ---------------------------------------------------\
\
// --- CONFIGURACI\'d3N DEL PREMIO ---\
const CODIGO_DESCUENTO = "PINTURA-15"; \
const PORCENTAJE_DESCUENTO = "15%"; \
const ENLACE_CATALOGO = "https://www.tuempresa.com/catalogo"; // \uc0\u55357 \u56392  \'a1TU ENLACE REAL!\
// ---------------------------------\
\
const LAST_PLAY_KEY = 'lastPlayDate';\
const resultMessage = document.getElementById('resultMessage');\
const quizContainer = document.getElementById('quiz-container');\
\
// Funci\'f3n de utilidad para mezclar un array (\'fatil para las opciones)\
function shuffleArray(array) \{\
    for (let i = array.length - 1; i > 0; i--) \{\
        const j = Math.floor(Math.random() * (i + 1));\
        [array[i], array[j]] = [array[j], array[i]];\
    \}\
    return array;\
\}\
\
// Funci\'f3n de utilidad para limpiar la respuesta (ignora may\'fasculas/min\'fasculas)\
function cleanAnswer(answer) \{\
    if (!answer) return "";\
    return answer.toLowerCase().trim().replace(/\'e1/g, 'a').replace(/\'e9/g, 'e').replace(/\'ed/g, 'i').replace(/\'f3/g, 'o').replace(/\'fa/g, 'u').replace(/,/g, '');\
\}\
\
\
// --- L\'d3GICA PRINCIPAL ---\
function checkPlayStatus() \{\
    const lastPlay = localStorage.getItem(LAST_PLAY_KEY);\
    const today = new Date().toDateString();\
\
    if (lastPlay === today) \{\
        showResult(`\uc0\u10060  L\'edmite diario alcanzado. Ya respondiste hoy. Vuelve ma\'f1ana para un nuevo acertijo.`, 'failure');\
        return;\
    \}\
    \
    // Si no ha jugado, carga y muestra el quiz\
    loadQuiz();\
\}\
\
function loadQuiz() \{\
    // 1. Elegir una pregunta al azar\
    const randomQuestionIndex = Math.floor(Math.random() * QUIZ_DATA.length);\
    const quizItem = QUIZ_DATA[randomQuestionIndex];\
    \
    // 2. Mezclar el orden de las opciones\
    const shuffledOptions = shuffleArray([...quizItem.options]);\
\
    // 3. Construir el HTML del Quiz\
    let optionsHtml = shuffledOptions.map(option => `\
        <label>\
            <input type="radio" name="answer" value="$\{option\}">\
            $\{option\}\
        </label>\
    `).join('<br>');\
\
    // 4. Mostrar el quiz y el bot\'f3n de enviar\
    quizContainer.innerHTML = `\
        <h2>$\{quizItem.question\}</h2>\
        <form id="quizForm">\
            $\{optionsHtml\}\
            <button type="submit" id="submitButton" data-correct-answer="$\{cleanAnswer(quizItem.correct_answer)\}">ENVIAR RESPUESTA</button>\
        </form>\
    `;\
\
    document.getElementById('quizForm').addEventListener('submit', function(e) \{\
        e.preventDefault(); // Evita que la p\'e1gina se recargue\
        checkAnswer(e);\
    \});\
\}\
\
function checkAnswer(e) \{\
    const form = e.target;\
    const selectedOption = form.querySelector('input[name="answer"]:checked');\
    const submitButton = form.querySelector('#submitButton');\
    const correctAnswerCleaned = submitButton.getAttribute('data-correct-answer');\
\
    if (!selectedOption) \{\
        alert("Por favor, selecciona una opci\'f3n antes de enviar.");\
        return;\
    \}\
    \
    const userAnswerCleaned = cleanAnswer(selectedOption.value);\
    \
    // Bloquear el juego y guardar la fecha\
    localStorage.setItem(LAST_PLAY_KEY, new Date().toDateString());\
    submitButton.disabled = true;\
\
    if (userAnswerCleaned === correctAnswerCleaned) \{\
        // GAN\'d3\
        const winMessage = `\
            <h2>\uc0\u55356 \u57225  \'a1\'a1RESPUESTA CORRECTA!! \'a1HAS GANADO! \u55356 \u57225 </h2>\
            <p>Tu beneficio es: <strong>\'a1$\{PORCENTAJE_DESCUENTO\} DE DESCUENTO!</strong></p>\
            <p>C\'d3DIGO DE CUP\'d3N: <strong>$\{CODIGO_DESCUENTO\}</strong></p>\
            <a href="$\{ENLACE_CATALOGO\}" target="_blank" class="catalogo-link">VER CAT\'c1LOGO AHORA</a>\
        `;\
        showResult(winMessage, 'success');\
    \} else \{\
        // PERDI\'d3\
        const loseMessage = `\
            <h2>\uc0\u55357 \u56852  Respuesta Incorrecta.</h2>\
            <p>Vuelve ma\'f1ana para intentar un nuevo acertijo.</p>\
        `;\
        showResult(loseMessage, 'failure');\
    \}\
\}\
\
function showResult(htmlContent, className) \{\
    // Esconde el quiz y muestra el resultado\
    document.getElementById('quiz-container').classList.add('hidden'); \
    resultMessage.innerHTML = htmlContent;\
    resultMessage.className = className;\
    resultMessage.classList.remove('hidden');\
\}\
\
document.addEventListener('DOMContentLoaded', checkPlayStatus);}